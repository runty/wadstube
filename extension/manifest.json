{
  "manifest_version": 3,
  "name": "WadsTube — Save channel",
  "version": "1.0.1",
  "description": "Save the YouTube channel you're watching to your WadsTube groups. Just your library, thoughtfully organized.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://wadstube.runty.org/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_title": "Save channel to WadsTube", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://wadstube.runty.org; img-src 'self' https://yt3.ggpht.com https://yt3.googleusercontent.com; base-uri 'none'; frame-src 'none'"
  }
}
